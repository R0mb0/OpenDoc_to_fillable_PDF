/* Toggle Switch rounded pill style for QPushButton#toggle_switch */
QPushButton#toggle_switch {
    background: #e6edf2;
    border-radius: 18px;          /* make it pill-shaped */
    min-width: 96px;
    min-height: 34px;
    padding: 0 12px;
    color: #25303a;
    font-weight: 600;
    border: 1px solid #cfd8dd;
    text-align: center;
}
QPushButton#toggle_switch:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #42a5f5, stop:1 #2b7fc8);
    color: #fff;
    border: 1px solid #1976d2;
}
QPushButton#toggle_switch:hover {
    border-color: #6faaf0;
}
QPushButton#toggle_switch:focus {
    outline: none;
}