/* Toggle Switch Material/iOS Style for checkable QPushButton (#toggle_switch) */
QPushButton#toggle_switch {
    background: #dfe6ea;
    border-radius: 16px;
    min-width: 72px;
    min-height: 28px;
    padding: 0 8px;
    color: #333;
    font-weight: 600;
    border: 1px solid #bfc9ce;
}
QPushButton#toggle_switch:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #42a5f5, stop:1 #2b7fc8);
    color: #fff;
    border: 1px solid #1976d2;
}
QPushButton#toggle_switch:hover {
    border-color: #6faaf0;
}
QPushButton#toggle_switch:focus {
    outline: none;
}